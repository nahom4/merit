# Copy to .env.local and fill in. Every key is parsed by one Zod schema at boot
# (packages/infrastructure/src/config.ts) -- a missing key fails on startup, not at 3am.

# --- Database -----------------------------------------------------------------
# Local development: a file on disk. No account, no card.
DATABASE_URL=file:./data/merit.db
# Turso only. Create a free database at https://turso.tech and run `turso db tokens create <name>`.
# Leave unset for local file databases.
# DATABASE_AUTH_TOKEN=

# --- Working directory --------------------------------------------------------
# Where IRS bundles and the Business Master File are staged. Bundles are deleted
# after parsing; budget ~250MB of free space for the largest one.
MERIT_DATA_DIR=./data

# --- IRS sources (free, keyless, no registration) ------------------------------
# Bulk 990 XML bundles: <base>/<year>/<year>_TEOS_XML_<part>.zip
IRS_BUNDLE_BASE_URL=https://apps.irs.gov/pub/epostcard/990/xml
# Exempt Organizations Business Master File: <base>/eo1.csv .. eo4.csv
IRS_BMF_BASE_URL=https://www.irs.gov/pub/irs-soi
# Which corpus year to ingest. 2025 is the year validated in validation/RESULTS.txt.
IRS_CORPUS_YEAR=2025

# --- ProPublica (free, keyless, no registration) -------------------------------
# Nonprofit Explorer, the source of the funder financial trend on the reachability
# report: <base>/organizations/<ein>.json
PROPUBLICA_BASE_URL=https://projects.propublica.org/nonprofits/api/v2
# The trend is supplementary -- the report renders without it -- so the leash is short.
PROPUBLICA_TIMEOUT_MS=8000

# --- Grants.gov (free, keyless, no registration) -------------------------------
# The federal opportunity feed: POST <base>/search2 and <base>/fetchOpportunity.
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api
GRANTS_GOV_TIMEOUT_MS=20000
# Attachments live on a different host than the API: api.grants.gov answers 403 for them.
# Reading them needs poppler-utils (`pdftotext`) on the PATH; without it, drafting falls back
# to summary-conditioned and says so, rather than failing.
GRANTS_GOV_ATTACHMENT_BASE_URL=https://grants.gov/grantsws/rest/opportunity/att/download
GRANTS_GOV_ATTACHMENT_TIMEOUT_MS=45000
# What the sweep searches for, comma-separated. A sweep with no terms finds nothing;
# a sweep of everything is 40,000 announcements. Track the organisation's program area.
FEDERAL_SWEEP_KEYWORDS=literacy,adult education,youth development
# Hits taken per search term. The sweep is incremental and idempotent, not exhaustive.
FEDERAL_SWEEP_PER_KEYWORD=10

# --- Gemini (free tier, no card) -----------------------------------------------
# Optional. Without a key Merit screens, stores, and serves everything it already has,
# and the federal board says "not scored yet" rather than failing -- an unset key is the
# most complete form of quota exhaustion. Get one at https://aistudio.google.com/apikey.
# GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000
# The free tier's published limits. The token bucket models them rather than discovering
# them by being punished with a 429.
GEMINI_REQUESTS_PER_MINUTE=15
GEMINI_REQUESTS_PER_DAY=1500

# --- Merit itself -------------------------------------------------------------
# Where this instance is reachable. Calendar reminders link back to it, and they are
# read days later on a phone with no tab open, so a relative path is no use.
MERIT_APP_BASE_URL=http://localhost:3100

# --- Google: Gmail and Calendar (free, OAuth) ----------------------------------
# All optional. Unset, Merit still saves an outreach record and opens Gmail's web
# compose window with the letter prefilled -- it just cannot read the mailbox back,
# so status stays "draft" until you mark it by hand.
# An OAuth client of type "Web application" at https://console.cloud.google.com/apis/credentials.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Must match the redirect URI registered on that client, exactly.
# GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/connect/callback
# Sign-in uses the same OAuth client with its own redirect. Register this one too.
GOOGLE_AUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# The Pub/Sub topic gmail.users.watch publishes to, as projects/<project>/topics/<topic>.
# Its push subscription posts to /api/gmail/webhook. Without it, no reply sync.
# GOOGLE_GMAIL_WATCH_TOPIC_NAME=
# A pre-minted token, for scripts and the contract test. The web app uses the OAuth
# flow above instead and stores its own tokens.
# GOOGLE_OAUTH_ACCESS_TOKEN=
GOOGLE_GMAIL_BASE_URL=https://gmail.googleapis.com/gmail/v1
GOOGLE_GMAIL_USER_ID=me
GOOGLE_CALENDAR_BASE_URL=https://www.googleapis.com/calendar/v3
GOOGLE_CALENDAR_ID=primary

# --- HTTP ---------------------------------------------------------------------
# The IRS server drops connections on large transfers; the downloader resumes rather
# than restarting, but each individual request still needs a bound.
HTTP_TIMEOUT_MS=120000
