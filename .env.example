# Copy to .env.local and fill in. Every key is parsed by one Zod schema at boot
# (packages/infrastructure/src/config.ts) -- a missing key fails on startup, not at 3am.

# --- Database -----------------------------------------------------------------
# Local development: a file on disk. No account, no card.
DATABASE_URL=file:./data/merit.db
# Turso only. Create a free database at https://turso.tech and run `turso db tokens create <name>`.
# Leave unset for local file databases.
# DATABASE_AUTH_TOKEN=

# --- Working directory --------------------------------------------------------
# Where IRS bundles and the Business Master File are staged. Bundles are deleted
# after parsing; budget ~250MB of free space for the largest one.
MERIT_DATA_DIR=./data

# --- IRS sources (free, keyless, no registration) ------------------------------
# Bulk 990 XML bundles: <base>/<year>/<year>_TEOS_XML_<part>.zip
IRS_BUNDLE_BASE_URL=https://apps.irs.gov/pub/epostcard/990/xml
# Exempt Organizations Business Master File: <base>/eo1.csv .. eo4.csv
IRS_BMF_BASE_URL=https://www.irs.gov/pub/irs-soi
# Which corpus year to ingest. 2025 is the year validated in validation/RESULTS.txt.
IRS_CORPUS_YEAR=2025

# --- HTTP ---------------------------------------------------------------------
# The IRS server drops connections on large transfers; the downloader resumes rather
# than restarting, but each individual request still needs a bound.
HTTP_TIMEOUT_MS=120000
